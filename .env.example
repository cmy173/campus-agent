# Documentation only: .env files are NOT loaded automatically.
# Set these in the terminal that starts the server. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional notice event extraction (independent of the Q&A model above).
# Endpoint is a fixed constant in campus_agent/notice_model.py; it cannot be
# overridden by environment, browser or notice content. Requests never follow redirects.
DEEPSEEK_API_KEY=
# Defaults to deepseek-flash. Letters, digits and . _ : - only; anything else disables the feature.
DEEPSEEK_MODEL=
# Only registered providers are accepted; an unknown value falls back to deepseek.
NOTICE_MODEL_PROVIDER=deepseek
# Optional, defaults to ./data in the project:
# CAMPUS_DATA_DIR=C:/your/private/campus-data
# Scoped to campus clients only: direct (compatibility default) or system.
# direct still follows OS routing / TUN. Browser WebVPN is not supported.
CAMPUS_NETWORK_POLICY=direct
# New credential-free college notice pages only; no automatic channel fallback.
# Independent of CAS, existing ZDBK notices, and OpenAI requests.
CAMPUS_PUBLIC_NETWORK_POLICY=system
# Note: model provider requests are NOT affected by the two campus policies above.

# Documentation only: .env files are NOT loaded automatically.
# Set these in the terminal that starts the server. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional, defaults to ./data in the project:
# CAMPUS_DATA_DIR=C:/your/private/campus-data
# Scoped to campus clients only: direct (compatibility default) or system.
# direct still follows OS routing / TUN. Browser WebVPN is not supported.
CAMPUS_NETWORK_POLICY=direct

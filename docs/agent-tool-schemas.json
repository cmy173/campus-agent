  },
  {
    "name": "plans.preview",
    "model_name": "campus_plans_preview",
    "description": "生成本次安排预览和差异，不生效。本周/明天由服务器按用户时区计算；临时约束不改长期偏好。",
    "input_schema": {
      "$defs": {
        "BlockedTime": {
          "additionalProperties": false,
          "properties": {
            "starts_at": {
              "maxLength": 64,
              "title": "Starts At",
              "type": "string"
            },
            "ends_at": {
              "maxLength": 64,
              "title": "Ends At",
              "type": "string"
            }
          },
          "required": [
            "starts_at",
            "ends_at"
          ],
          "title": "BlockedTime",
          "type": "object"
        },
        "TemporaryWindow": {
          "additionalProperties": false,
          "properties": {
            "weekday": {
              "maximum": 7,
              "minimum": 1,
              "title": "Weekday",
              "type": "integer"
            },
            "start": {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "title": "Start",
              "type": "string"
            },
            "end": {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "title": "End",
              "type": "string"
            }
          },
          "required": [
            "weekday",
            "start",
            "end"
          ],
          "title": "TemporaryWindow",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "period": {
          "default": "this_week",
          "enum": [
            "this_week",
            "tomorrow",
            "dates"
          ],
          "title": "Period",
          "type": "string"
        },
        "start_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/BlockedTime"
          },
          "maxItems": 64,
          "title": "Blocked",
          "type": "array"
        },
        "temporary_windows": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TemporaryWindow"
              },
              "maxItems": 56,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporary Windows"
        },
        "unavailable_evenings": {
          "description": "本周不可用的晚上，ISO 星期1至7；服务端按18:00至次日00:00转换并在预览中明示。仅适用于this_week。",
          "items": {
            "maximum": 7,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 7,
          "title": "Unavailable Evenings",
          "type": "array"
        }
      },
      "title": "PreviewArgs",
      "type": "object"
    },
    "effects": "write",
    "version": 1
  },

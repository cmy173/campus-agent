  {
    "name": "tasks.feedback",
    "model_name": "campus_tasks_feedback",
    "description": "仅记录用户明确报告的本地学习结果，先读任务版本；未报告的时间/难度留空。不修改学校提交状态。",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "completed",
            "partial",
            "skipped"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "actual_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Minutes"
        },
        "difficulty": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "task_id",
        "expected_revision",
        "outcome"
      ],
      "title": "FeedbackArgs",
      "type": "object"
    },
    "effects": "write",
    "version": 1
  }
